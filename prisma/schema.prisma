// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  accounts      Account[]
  sessions      Session[]
  teacher       Teacher?
  activityLogs  ActivityLog[]
  weeklyReports WeeklyCoordinationReport[]
}

enum FaultType {
  FALTA_DE_MATERIAL
  AUSENCIA_NA_SALA
}

model Teacher {
  id        String   @id @default(cuid())
  userId    String   @unique
  name      String
  role      String   @default("COORDENADOR")
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  turmas  Turma[]
  direccaoAssignments DireccaoTurma[]
  turmaAssignments TeacherTurma[]
}

model Turma {
  id           String   @id @default(cuid())
  name         String
  code         String?  @unique
  schedule     String?
  coordinatorId String?
  createdAt    DateTime @default(now())

  coordinator Teacher? @relation(fields: [coordinatorId], references: [id], onDelete: SetNull)
  students    Student[]
  subjects    Subject[]
  weeklyReports WeeklyCoordinationReport[]
  direccaoAssignments DireccaoTurma[]
  teacherAssignments TeacherTurma[]
}

model DireccaoTurma {
  teacherId String
  turmaId   String

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  turma   Turma   @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([teacherId, turmaId])
  @@index([turmaId])
}

model TeacherTurma {
  teacherId String
  turmaId   String
  isMain    Boolean  @default(false)

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  turma   Turma   @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@id([teacherId, turmaId])
  @@index([turmaId])
}

model Subject {
  id        String   @id @default(cuid())
  turmaId   String
  name      String
  createdAt DateTime @default(now())

  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([turmaId, name])
  @@index([turmaId])
}

model Student {
  id          String   @id @default(cuid())
  turmaId     String
  name        String
  age         Int?
  attendance  String?  @default("P")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  turma       Turma         @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  grades      Grade[]
  absences    Absence[]
  notes       StudentNote[]
  parents     Parent[]
}

model Parent {
  id        String  @id @default(cuid())
  studentId String
  name      String
  phone     String
  email     String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model Grade {
  id        String   @id @default(cuid())
  studentId String
  subject   String
  value     Float
  term      String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Absence {
  id         String    @id @default(cuid())
  studentId  String
  subject    String
  dia        DateTime
  tempo      String
  faultType  FaultType @default(FALTA_DE_MATERIAL)
  notes      String?   @db.Text
  justified  Boolean   @default(false)
  justificationTitle String?
  justificationNotes String? @db.Text
  attachmentUrl String?
  attachmentPathname String?
  attachmentName String?
  attachmentContentType String?
  attachmentSize Int?
  createdAt  DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, subject, dia, tempo])
}

model StudentNote {
  id        String   @id @default(cuid())
  studentId String
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id        String   @id @default(cuid())
  actorId   String
  actorName String
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([createdAt])
}

model WeeklyCoordinationReport {
  id          String   @id @default(cuid())
  userId      String
  turmaId     String
  weekStart   DateTime
  weekEnd     DateTime
  title       String
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([userId, turmaId, weekStart])
  @@index([turmaId])
  @@index([weekStart])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
