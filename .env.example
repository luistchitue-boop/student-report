# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@host/database

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-generate-with-openssl-rand-base64-32

# Twilio Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# A real SMS-capable Twilio phone number, not the WhatsApp sender above.
TWILIO_SMS_FROM=+17372212163
# Optional trial-compatible SMS template configuration. The template must define {{1}} for the report name and {{2}} for the PDF URL.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SMS_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email Configuration
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=AEph Reports <reports@your-verified-domain.com>
# Create a Resend webhook for email.delivered, email.bounced, email.failed, and email.delivery_delayed.
# Point it to https://your-school-domain.vercel.app/api/webhooks/resend and copy its signing secret here.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Public Configuration
NEXT_PUBLIC_APP_URL=https://your-school-domain.vercel.app